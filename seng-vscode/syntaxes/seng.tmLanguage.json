{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Seng",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#operators" },
    { "include": "#numbers" },
    { "include": "#calls" }
  ],
  "repository": {
    "comments": {
      "patterns": [{
        "name": "comment.line.number-sign.se",
        "match": "#.*$"
      }]
    },
    "strings": {
      "name": "string.quoted.double.se",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.se", "match": "\\\\." }
      ]
    },
    "keywords": {
      "patterns": [{
        "name": "keyword.control.se",
        "match": "\\b(if|then|else|end|while|repeat|times|for|each|in|try|catch|throw|define|with|give back|stop|skip|import|blueprint|from|has|hidden|create|instance|of|called|me)\\b"
      }, {
        "name": "keyword.other.se",
        "match": "\\b(set|to|say|ask|for|make|list|dictionary|add|remove|item|length)\\b"
      }]
    },
    "operators": {
      "patterns": [{
        "name": "keyword.operator.word.se",
        "match": "\\b(plus|minus|times|divided by|mod|is equal to|is not equal to|is greater than|is less than|and|or|not|is|greater|less|equal|than)\\b"
      }, {
        "name": "keyword.operator.symbol.se",
        "match": "[\\+\\-\\*/%\\^=<>&\\|!]"
      }]
    },
    "numbers": {
      "patterns": [{
        "name": "constant.numeric.se",
        "match": "\\b\\d+(\\.\\d+)?\\b"
      }]
    },
    "calls": {
      "patterns": [{
        "name": "entity.name.function.se",
        "match": "\\b(result of|call)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
        "captures": {
          "2": { "name": "entity.name.function.se" }
        }
      }]
    }
  },
  "scopeName": "source.se"
}
